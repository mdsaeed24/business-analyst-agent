{
  "name": "business-analyst-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "data:seed": "tsx scripts/seed-synthetic-data.ts",
    "data:reset:synthetic": "tsx scripts/reset-synthetic-data.ts",
    "metrics:compute": "tsx scripts/compute-metrics.ts",
    "auth:create-user": "tsx scripts/create-user.ts",
    "sync:connect:stripe": "tsx scripts/connect-stripe.ts",
    "sync:worker": "tsx scripts/sync-worker.ts",
    "sync:once": "tsx scripts/sync-worker.ts --once",
    "demo:export": "tsx scripts/export-portfolio-demo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.0.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
