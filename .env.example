# Server-only. Replace placeholders and store in .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional Phase 6; never prefix these with NEXT_PUBLIC_.
DEEPSEEK_ENABLED="false"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"

# Optional Phase 7; choose a voice available to your ElevenLabs account.
ELEVENLABS_ENABLED="false"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL="eleven_flash_v2_5"

# Optional Phase 8. Read-only Stripe API key; no NEXT_PUBLIC_ prefix.
LIVE_SYNC_ENABLED="false"
STRIPE_SECRET_KEY=""
